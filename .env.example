# Optional Recordly accounts: set to 1 and fill in the Supabase project below.
# Recording and editing never need an account.
VITE_RECORDLY_ACCOUNTS=0

# Public client configuration. Never put a Supabase service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Leave blank until the hosted recording service is deployed and verified.
# Development defaults to localhost:8787; packaged builds require an explicit URL.
VITE_CLOUD_SHARE_ENDPOINT=

# Optional: your Google Cloud OAuth client (type "Desktop app") for posting to YouTube
# straight from Recordly. Customers sign in with their own Google account; no server.
VITE_YOUTUBE_CLIENT_ID=
VITE_YOUTUBE_CLIENT_SECRET=

# Optional: your TikTok developer app (Login Kit for Desktop + Content Posting API).
# Register the redirect URI http://127.0.0.1:*/callback/ . TikTok's token endpoint needs the
# secret, so it is built into the app.
VITE_TIKTOK_CLIENT_KEY=
VITE_TIKTOK_CLIENT_SECRET=

# Optional: your X developer app, type "Native App" (public client, no secret). Register
# http://127.0.0.1:43827/callback, http://127.0.0.1:43828/callback and http://127.0.0.1:43829/callback
VITE_X_CLIENT_ID=

# Optional: your Meta app id (Facebook Login, desktop flow; no secret) for Facebook Pages
# and the Instagram professional accounts linked to them.
VITE_META_APP_ID=

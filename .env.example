# Optional Recordly accounts: set to 1 and fill in the Supabase project below.
# Recording and editing never need an account.
VITE_RECORDLY_ACCOUNTS=0

# Public client configuration. Never put a Supabase service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Leave blank until the hosted recording service is deployed and verified.
# Development defaults to localhost:8787; packaged builds require an explicit URL.
VITE_CLOUD_SHARE_ENDPOINT=

# Optional: your company's open-source Postiz server, pre-filled on the Social page.
VITE_POSTIZ_SERVER_URL=

# Optional: your Google Cloud OAuth client (type "Desktop app") for posting to YouTube
# straight from Recordly. Customers sign in with their own Google account; no server.
VITE_YOUTUBE_CLIENT_ID=
VITE_YOUTUBE_CLIENT_SECRET=

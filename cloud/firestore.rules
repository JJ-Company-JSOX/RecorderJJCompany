rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function member(ws) {return request.auth != null && exists(/databases/$(database)/documents/workspaces/$(ws)/members/$(request.auth.uid)) && get(/databases/$(database)/documents/workspaces/$(ws)/members/$(request.auth.uid)).data.active == true && get(/databases/$(database)/documents/workspaces/$(ws)/members/$(request.auth.uid)).data.role in ['owner','editor','viewer'];}
  match /users/{uid} { allow get: if request.auth != null && request.auth.uid == uid; allow list, write: if false; }
  match /workspaces/{ws} {
   allow get: if member(ws); allow list, write: if false;
   match /members/{uid} {allow get: if member(ws); allow list, write: if false;}
   match /aiUsageRecords/{record} {
    allow read: if member(ws) && (resource.data.uid == request.auth.uid || get(/databases/$(database)/documents/workspaces/$(ws)/members/$(request.auth.uid)).data.role == 'owner');
    allow write: if false;
   }
   match /auditLogs/{record} {
    allow read: if member(ws) && get(/databases/$(database)/documents/workspaces/$(ws)/members/$(request.auth.uid)).data.role == 'owner';
    allow write: if false;
   }
   match /{collection}/{document=**} {
    allow read: if member(ws) && collection in ['videos','videoEmbeddings','aiMixProjects','brollSuggestions','assetApprovals','timelineVersions','exportJobs'];
    // State transitions, approvals, billing, embedding vectors and immutable versions are server-owned.
    allow write: if false;
   }
  }
 }
}

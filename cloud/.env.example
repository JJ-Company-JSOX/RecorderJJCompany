# Project exists; actual database location, bucket and service accounts MUST be inspected before deployment.
GOOGLE_CLOUD_PROJECT=d-recorder-ef064
STUDIO_REGION=asia-southeast1
STUDIO_BUCKET=REPLACE_WITH_CONFIRMED_PRIVATE_BUCKET
STUDIO_WORKER_URL=https://REPLACE_WITH_PRIVATE_CLOUD_RUN_SERVICE.run.app
STUDIO_TASK_QUEUE=jsox-cpu
STUDIO_TASK_SERVICE_ACCOUNT=REPLACE_WITH_TASK_INVOKER_SERVICE_ACCOUNT
# Select a currently available, priced Gemini model and review its processing terms.
GEMINI_MODEL=REPLACE_WITH_VERIFIED_MODEL_ID
WHISPER_MODEL_DIR=/models/REPLACE_WITH_APPROVED_CPU_MODEL
WHISPER_MODEL_REVISION=REPLACE_WITH_VERIFIED_MODEL_REVISION
WORKER_VCPUS=4
STOCK_TERMS_REVIEWED=false
# GEMINI_API_KEY / PEXELS_API_KEY / PIXABAY_API_KEY belong in Secret Manager, never this file or clients.
